# Plantilla de app/config.env (valores no secretos). Copiala a config.env y rellenala; config.env no se versiona.
# Canal de Slack donde Hugo publica el aviso de arranque.
HUGO_AVISO_CANAL=
# Id de Slack de la unica persona que puede dar ordenes y confirmar con el pulgar arriba.
HUGO_USUARIO=
# Id de Slack de un asistente que puede PEDIR actualizar, registra y sincroniza registros; su pulgar confirma solo registra (decision del usuario, 15-nov-2026). Vacio: nadie.
HUGO_DELEGADO=
# Repositorio del que Hugo se actualiza con "@Hugo actualiza" (propietario/repositorio, publico).
HUGO_GITHUB=
# Opcional: carpeta donde recibir archivos (por defecto, Descargas).
# HUGO_RECIBIDOS=
# Opcional: carpeta base del registro de velas (por defecto ~/Documents/hugo/registros/velas-24h).
# HUGO_VELAS_DIR=
